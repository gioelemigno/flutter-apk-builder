# Optional: copy this file to `.env` (docker compose reads it automatically).
# The defaults below are already built into compose.yaml, so agents and people using
# the published image do not need a .env at all.

# Where the image lives (must be lowercase). Docker Hub: docker.io/<user>; GitHub: ghcr.io/<user>
REGISTRY=docker.io/gmigno

# Image tag:  3.47.9         plain apps
#             3.47.9-common  packages of the Timegrapher Log app baked in (camera, drift, riverpod, ...)
IMAGE_TAG=3.47.9
